# Helio PMS — front-end configuration
#
#   cp .env.example .env.local      then edit
#
# Everything here is compiled into the bundle by `npm run build` and is
# readable by anyone who opens the page. NOTHING SECRET GOES IN THIS FILE.
# There is no such thing as a private value in a browser build — API keys,
# tokens and passwords belong to the API, behind a login.
#
# Because the values are inlined at build time, changing one means rebuilding.
# Setting a variable on the server that serves the bundle does nothing.
#
# Files are read in this order, each overriding the one before it:
#
#     .env                  committed, safe defaults for every mode
#     .env.local            this machine, never committed
#     .env.<mode>           committed, per-environment (mode is Vite's --mode)
#     .env.<mode>.local     this machine, per-environment, never committed
#
# Only variables beginning with VITE_ are exposed to the app. Anything else in
# these files is visible to the build and not to the browser.
#
# Every variable is declared in src/config.ts. The build refuses to produce a
# bundle when a required one is missing.

# ─── API ───────────────────────────────────────────────────────

# Base URL of the Helio API.
#
# Must be an origin the API allows in its own CORS_ORIGIN list, or every
# request fails in a way the app cannot tell apart from the server being down.
#
# Required for a production build. In development it defaults to the API's own
# default port, so `npm run dev` works with no configuration at all.
#
# required for a build · a URL (http or https)
# default in development: https://api.funbunkpms.grobern.com
VITE_API_URL=https://api.funbunkpms.grobern.com

# ─── Branding ──────────────────────────────────────────────────

# What the distribution partner is called anywhere a user can read it.
#
# The default hides the supplier's name from customers — a channel-manager
# contract is a supplier relationship, not a product feature. Set it to the
# real name on an internal build, where the setup instructions are easier to
# follow with it.
#
# Must match HELIO_CHANNEL_HUB_NAME on the API, or the two halves of the app
# disagree on screen.
#
# optional · text
# default: the channel manager
# VITE_CHANNEL_HUB_NAME=the channel manager

# Short form of the same, for field labels: "Channel room id" rather than
# "the channel manager room id".
#
# optional · text
# default: Channel
# VITE_CHANNEL_HUB_SHORT=Channel

# Public address of this app, used when building a link somebody else opens —
# the check-in QR code on a new reservation, for one.
#
# Defaults to whatever host served the page, which is right in production and
# useless on a laptop: a QR containing "localhost:3000" sends a phone to itself.
# Set it to the address staff phones can actually reach — this machine's
# network address while developing (http://192.168.1.20:3000), or the deployed
# site. The panel warns when the resulting link cannot be scanned.
#
# optional · a URL (http or https)
# default: the host serving the page
# VITE_APP_URL=https://pms.example.com
