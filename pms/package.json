    "verify:concurrency": "npm --prefix backend run concurrency",
    "verify:backup": "npm --prefix backend run backup-check",
    "verify:closeouts": "npm --prefix backend run closeout-check",
    "verify:staydates": "npm --prefix backend run staydates-check",
